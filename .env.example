# Copy this file to .env and adjust for your environment.

APP_NAME="Bidii Credit API"
ENVIRONMENT=development

# SQLite by default — zero setup. Point this at Postgres/MySQL in production,
# e.g. postgresql+psycopg://user:password@host:5432/bidii
DATABASE_URL=sqlite:///./bidii.db

# Comma-separated origins allowed to call this API. Add your deployed
# frontend's URL here in production (e.g. https://www.bidiicreditkenya.co.ke).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

MAX_UPLOAD_SIZE_MB=5

# Admin dashboard login — CHANGE THESE before deploying anywhere real.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# JWT signing secret for admin sessions — CHANGE THIS in production
# (e.g. `openssl rand -hex 32`).
JWT_SECRET=dev-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=480
